    "with open('rosalind_hamm.txt', 'r') as f:\n",
    "    lines = f.read().splitlines()\n",
    "\n",
    "a = lines[0]\n",
    "b = lines[1]\n",
    "\n",
    "count = 0\n",
    "\n",
    "for i in range(len(a)):\n",
    "    if a[i] != b[i]:\n",
    "        count = count + 1\n",
    "\n",
    "print(count)"
   ]
