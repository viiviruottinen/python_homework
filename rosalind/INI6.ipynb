    "with open('rosalind_ini6.txt', 'r') as f:\n",
    "    s = f.read()\n",
    "\n",
    "word_count = {}\n",
    "\n",
    "for word in s.split():\n",
    "    if word in word_count:\n",
    "        word_count[word] = word_count[word] + 1\n",
    "    else:\n",
    "        word_count[word] = 1\n",
    "\n",
    "for key, value in word_count.items():\n",
    "    print(key, value)"
