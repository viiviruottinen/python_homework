   "source": [
    "# n = months\n",
    "# k = new rabbit pairs\n",
    "\n",
    "# F1 = 1\n",
    "# F2 = 1\n",
    "\n",
    "def recurrence_relation(n, k):\n",
    "    if n == 1 or n == 2:\n",
    "        return 1\n",
    "    else:\n",
    "        return recurrence_relation(n - 1, k) + k * recurrence_relation(n - 2, k)\n",
    "        # F3 = 1 + (3 * 1)\n",
    "\n",
    "print(recurrence_relation(33, 4))"
   ]
  }
 ],
